APP_BASE_URL=https://molin-image.example.com
APP_ENV=development
DATABASE_URL=mysql://molin_image_user:replace_password@127.0.0.1:3306/molin_image
REDIS_URL=redis://127.0.0.1:6379/0
# Redis 基础前缀会自动追加 APP_ENV，形成例如 molinimage:development，避免环境间 Key 冲突。
REDIS_KEY_PREFIX=molinimage
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=3
IMAGE_TASK_QUEUE_NAME=molinimage-image-tasks
IMAGE_TASK_WORKER_CONCURRENCY=2
IMAGE_TASK_JOB_ATTEMPTS=3
IMAGE_TASK_JOB_TIMEOUT_MS=120000
# 卡住任务恢复扫描间隔、判定时长和单批数量。
IMAGE_TASK_RECOVERY_SCAN_INTERVAL_MS=30000
IMAGE_TASK_STUCK_AFTER_MS=300000
IMAGE_TASK_RECOVERY_BATCH_SIZE=50
# Worker 每 5 秒刷新一次 15 秒 TTL 心跳；监控阈值只使用数量和时长，不记录任务内容。
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_SECONDS=15
QUEUE_BACKLOG_ALERT_THRESHOLD=20
QUEUE_OLDEST_WAIT_ALERT_MS=60000
OUTBOX_BACKLOG_ALERT_THRESHOLD=10
# 单个依赖探针最多等待 5 秒，readiness 结果缓存 1 秒并合并并发请求。
HEALTH_PROBE_TIMEOUT_MS=5000
HEALTH_READINESS_CACHE_TTL_MS=1000
# 本地灰度可使用 inline；生产环境必须使用 queue。
IMAGE_TASK_EXECUTION_MODE=inline
# Outbox 扫描间隔、单批数量、最大等待时间和最大退避时间。
IMAGE_TASK_OUTBOX_POLL_INTERVAL_MS=1000
IMAGE_TASK_OUTBOX_BATCH_SIZE=20
IMAGE_TASK_OUTBOX_MAX_WAIT_MS=300000
IMAGE_TASK_OUTBOX_MAX_BACKOFF_MS=60000
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=molin-image-dev
STORAGE_ACCESS_KEY_ID=replace_with_storage_access_key
STORAGE_SECRET_ACCESS_KEY=replace_with_storage_secret_key
STORAGE_PRESIGNED_URL_TTL_SECONDS=300
MOLING_API_BASE_URL=https://moling-api.example.com
MOLING_APP_ID=990008
MOLING_PRODUCT_ID=990107
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_API_KEY=replace_with_openrouter_api_key
IMAGE_MODEL_ENABLED_CAPABILITIES=image_generation,vision_text,moderation,image_edit,image_restore,upscale,prompt_optimize
IMAGE_MODEL_REQUIRED_CAPABILITIES=image_generation,vision_text,moderation
IMAGE_MODEL_CATALOG_JSON=[{"gateway_model_code":"google/gemini-3.1-flash-lite-image","display_name":"通用图片生成","description":"OpenRouter 通用图片生成模型，适合文生图、图生图、图片修复和高清放大。","capability":"image_generation","status":"active","quality_tier":"standard","supported_task_types":["text_to_image"],"supported_image_sizes":["512x512","640x640","768x768","896x896","1024x1024","512x768","640x960","768x1024","896x1152","960x1280","720x1280","1024x1536","640x360","768x512","896x512","960x640","1024x768","1280x720","1280x960","1536x1024"],"supported_input_types":["text"],"supported_output_types":["image"],"max_input_files":0,"max_output_count":4,"sort_order":10},{"gateway_model_code":"google/gemini-3.1-flash-lite-image","display_name":"通用图生图","description":"OpenRouter 通用图片编辑模型，第一版用于参考图生成、风格变换和图片修复。","capability":"image_edit","status":"active","quality_tier":"standard","supported_task_types":["image_to_image","image_restore","upscale"],"supported_image_sizes":["512x512","640x640","768x768","896x896","1024x1024","512x768","640x960","768x1024","896x1152","960x1280","720x1280","1024x1536","640x360","768x512","896x512","960x640","1024x768","1280x720","1280x960","1536x1024"],"supported_input_types":["image","text"],"supported_output_types":["image"],"max_input_files":1,"max_output_count":4,"sort_order":20},{"gateway_model_code":"google/gemini-3.1-flash-lite-image","display_name":"通用图片理解","description":"OpenRouter 通用视觉理解模型，用于图片描述、标题、标签和提示词反推。","capability":"vision_text","status":"active","quality_tier":"standard","supported_task_types":["image_to_text"],"supported_image_sizes":[],"supported_input_types":["image"],"supported_output_types":["text"],"max_input_files":1,"max_output_count":1,"sort_order":30},{"gateway_model_code":"deepseek/deepseek-v4-flash","display_name":"通用提示词优化","description":"OpenRouter DeepSeek 通用文本模型，用于提示词优化和文本安全审核。","capability":"prompt_optimize","status":"active","quality_tier":"standard","supported_task_types":["prompt_optimize"],"supported_image_sizes":[],"supported_input_types":["text"],"supported_output_types":["text"],"max_input_files":0,"max_output_count":1,"sort_order":40},{"gateway_model_code":"deepseek/deepseek-v4-flash","display_name":"通用内容审核","description":"OpenRouter DeepSeek 通用文本模型，第一版用于提示词和文本内容安全审核。","capability":"moderation","status":"active","quality_tier":"standard","supported_task_types":["moderation"],"supported_image_sizes":[],"supported_input_types":["text"],"supported_output_types":["text"],"max_input_files":0,"max_output_count":1,"sort_order":50}]
BILLING_RULES_JSON=[{"task_type":"text_to_image","usage_type":"image_text_to_image","unit":"credits","points_per_unit":"6","active":true},{"task_type":"image_to_image","usage_type":"image_to_image","unit":"credits","points_per_unit":"8","active":true},{"task_type":"image_restore","usage_type":"image_restore","unit":"credits","points_per_unit":"5","active":true},{"task_type":"image_to_text","usage_type":"image_to_text","unit":"credits","points_per_unit":"1","active":true},{"task_type":"upscale","usage_type":"image_upscale","unit":"credits","points_per_unit":"4","upscale_factor":2,"active":true},{"task_type":"upscale","usage_type":"image_upscale","unit":"credits","points_per_unit":"8","upscale_factor":4,"active":true}]
BILLING_MOCK_BALANCE_POINTS=1000000
# 风控统计窗口，单位秒。用户级和 IP 级限流共用该窗口。
RISK_CONTROL_WINDOW_SECONDS=60
# 单个用户在窗口内最多允许创建多少个图片任务；0 表示关闭用户级限流。
RISK_CONTROL_USER_LIMIT=20
# 单个 IP 在窗口内最多允许创建多少个图片任务；0 表示关闭 IP 级限流。
RISK_CONTROL_IP_LIMIT=60
# 临时关闭的高风险任务类型，多个值用英文逗号分隔，例如 image_restore,upscale。
RISK_CONTROL_DISABLED_TASK_TYPES=
# 临时关闭的 AI 网关能力标签，多个值用英文逗号分隔，例如 image_restore,upscale。
RISK_CONTROL_DISABLED_CAPABILITIES=
# 是否信任反向代理传入的 X-Forwarded-For。只有代理会覆盖该头时才设为 true。
TRUST_PROXY=false
INTERNAL_API_TOKEN=replace_with_internal_api_token
# 可进入 /admin/pricing 的墨灵用户 ID，多个值用英文逗号分隔。
MOLINIMAGE_ADMIN_USER_IDS=
# 本地灰度可使用 memory；生产环境必须使用 redis。
SESSION_STORE=memory
SESSION_COOKIE_NAME=molinimage_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
PORT=5199
